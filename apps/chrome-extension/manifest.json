{
  "manifest_version": 3,
  "name": "Tyno Connect",
  "version": "1.0.0",
  "description": "Connecte votre navigateur à Tyno Entreprise — import Temu, Leboncoin, Vinted",
  "permissions": ["storage", "activeTab", "notifications"],
  "host_permissions": [
    "https://*.temu.com/*",
    "https://www.leboncoin.fr/*",
    "https://www.vinted.fr/*"
  ],
  "background": {
    "service_worker": "service-worker/sw.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://*.temu.com/*"],
      "js": ["lib/storage.js", "lib/api-client.js", "content-scripts/temu.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.leboncoin.fr/*"],
      "js": ["lib/storage.js", "lib/api-client.js", "content-scripts/lbc.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.vinted.fr/*"],
      "js": ["lib/storage.js", "lib/api-client.js", "content-scripts/vinted.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
