# ─── Backend ──────────────────────────────────────────────────────────────────
API_PORT=3001
API_SECRET_TOKEN=changeme_strong_random_token
DB_PATH=/data/hermes/hermes.db
JOB_INTERVAL_MS=5000
JOB_CONCURRENCY=2

# ─── Pricing ──────────────────────────────────────────────────────────────────
PRICE_MULTIPLIER=3.0
MIN_MARGIN_EUR=5.0

# ─── Web site ─────────────────────────────────────────────────────────────────
WEB_PORT=3000
WEB_SECRET_TOKEN=changeme_web_token
API_BASE_URL=http://localhost:3001

# ─── Telegram bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # token BotFather — jamais committer
TELEGRAM_ALLOWED_CHAT_IDS=   # chat_id numérique de l'opérateur

# ─── Leboncoin — sessions Playwright (Claude 3) ───────────────────────────────
# Pas d'API officielle LBC — automation Playwright uniquement
# Les sessions sont stockées dans /data/hermes/sessions/<account_id>.json
CHROMIUM_PATH=/usr/bin/chromium   # Docker / VPS Ubuntu : /usr/bin/chromium ou /usr/bin/chromium-browser
SESSIONS_DIR=/data/hermes/sessions   # sessions Playwright LBC (cookies)
MEDIA_DIR=/data/hermes/media         # photos produits téléchargées

# ─── Repricing automatique ────────────────────────────────────────────────────
REPRICE_DAYS_1=7          # jours entre chaque cycle de baisse
REPRICE_STEP_PCT=0.15     # % de baisse à chaque repricing (0.15 = -15%)
REPRICE_INTERVAL_H=24     # intervalle de vérification en heures
MAX_REPRICE_COUNT=3       # nb max de baisses avant archivage (3 = suppression à la 3ème)
DAILY_LISTING_MAX=100     # nb max de nouvelles annonces publiées par jour (0 = illimité)
PUBLISH_HOUR_START=8      # heure de début de publication automatique (heure locale)
PUBLISH_HOUR_END=18       # heure de fin de publication automatique (heure locale)
PUBLISH_TICK_MIN=6        # intervalle en minutes entre chaque tick du scheduler de publication
# MIN_MARGIN_EUR défini dans la section Pricing ci-dessus

# ─── Négociation automatique (Claude B) ───────────────────────────────────────
NEGO_ACCEPT_PCT=0.95     # offre >= 95% du prix → accepter
NEGO_COUNTER_PCT=0.85    # offre >= 85% du prix → contre-proposer à 95%
NEGO_REFUSE_PCT=0.70     # offre < 70% du prix → refuser

# ─── Claude API — répondeur automatique (Claude B) ────────────────────────────
ANTHROPIC_API_KEY=       # clé Anthropic — jamais committer
OPENAI_API_KEY=          # clé OpenAI pour régénération photos (optionnel — fallback sharp si absent)
CLAUDE_MODEL=claude-haiku-5-5   # modèle utilisé pour les réponses acheteurs
