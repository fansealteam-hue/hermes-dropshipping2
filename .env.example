# ─── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
DB_PATH=./data/hermes.db
JOB_INTERVAL_MS=30000

# ─── Bot Telegram ─────────────────────────────────────────────────────────────
# Obtenir depuis @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=
# ID du chat opérateur (utiliser @userinfobot pour le trouver)
TELEGRAM_CHAT_ID=

# ─── Communication bot ↔ backend ─────────────────────────────────────────────
API_BASE_URL=http://localhost:3000

# ─── Extension Chrome ─────────────────────────────────────────────────────────
# Token partagé entre l'extension et le backend (générer avec: openssl rand -hex 32)
EXTENSION_API_TOKEN=

# ─── Frais (optionnel — valeurs par défaut si absent) ────────────────────────
TEMU_SHIPPING_FEE=2.99

# ─── Automatisation nocturne ─────────────────────────────────────────────────
# Mettre à "true" pour désactiver temporairement le scheduler
NOCTURNAL_DISABLED=false
